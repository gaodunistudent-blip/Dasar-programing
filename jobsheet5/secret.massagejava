import java.util.Scanner;

public class Secret {
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);

        System.out.print("Write your name: ");
        String name = input.nextLine().trim();

        System.out.println();

        if (name.equalsIgnoreCase("Glih")) {
            System.out.println("Okay Glih, here's your secret message 👀");
            System.out.println();
            System.out.println("Not gonna lie, I would've been COOKED");
            System.out.println("on Thursday without your help 💀");
            System.out.println("So yeah, I owe you one.");
            System.out.println("Consider this your well-deserved credit.");
            System.out.println("Started from the bottom... you know the rest.");
            System.out.println();
            System.out.println("Anyway, thanks. I appreciate it :)");
        } else {
            System.out.println("Wrong person. Nothing to see here 💀");
        }

        input.close();
    }
}